{
  "expo": {
    "name": "calculadora-do-feirante",
    "slug": "calculadora-do-feirante",
    "version": "1.0.0",
    "orientation": "portrait",
    "versionCode": 3,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "APP_NAME": "Calculadora do Feirante",
      "eas": {
        "projectId": "d05bb439-9f8d-46b2-832c-aa8c39253b7f"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arthurfrc.calculadora.feirante"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1296094569685364~5078657156"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ]
  }
}